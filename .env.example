# Copy to .env.local and fill in. All are optional in development.

# Absolute origin, no trailing slash. Used for canonicals, OG URLs, sitemap and
# JSON-LD @ids — set it per environment or previews will emit production URLs.
NEXT_PUBLIC_SITE_URL=https://vanzoo.in

# Google Tag Manager container. Leave empty to omit the tag entirely (useful
# for previews, so staging traffic never lands in production analytics).
NEXT_PUBLIC_GTM_ID=

# Search Console verification token — the `content` value of the
# google-site-verification meta tag. Leave empty to omit the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Where /api/enquiry forwards submissions (mail provider, CRM or automation
# webhook). Unset, the endpoint validates and logs but does not deliver.
ENQUIRY_WEBHOOK_URL=

# --- Enquiry storage (set at least one on a deployed site) -----------------
# Email each enquiry via Resend: https://resend.com (free tier is plenty).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=care@vanzoo.in
# Optional; must be a sender verified in Resend. Defaults to Resend's test sender.
ENQUIRY_FROM_EMAIL=
# Enquiries are also appended to data/enquiries.jsonl on a normal server / in dev.

# --- Admin panel (/admin) ---------------------------------------------------
# Login for /admin. Both default to "admin" when unset — change them on a live site.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Where admin settings (e.g. the Delhi switch) are saved. Required on Vercel —
# create a free database at https://upstash.com and paste its REST URL and token.
# Without these, settings are saved to data/settings.json (non-Vercel hosts only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CMS (admin.vanzoo.in) ---------------------------------------------------
# MySQL (or use MYSQL_URL=mysql://user:pass@host:3306/dbname)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Port the Node server listens on (Hostinger sets this). The server calls itself on 127.0.0.1:$PORT for redirects and boot-time cache refresh.
PORT=
# Random string, 24+ characters. Required in production for admin sessions.
SESSION_SECRET=
# Make the admin reachable only on this host (public domain answers 404 for /admin).
ADMIN_HOST=admin.vanzoo.in
# Absolute folder for uploaded media, OUTSIDE the deployed app so redeploys keep it.
UPLOAD_DIR=
# ADMIN_USERNAME / ADMIN_PASSWORD above are used once by `npm run db:migrate` to create the first admin.

# --- Optional: Google Search Console data in SEO -> Search data (read-only, free) ---
# A service account added as a Restricted user on your Search Console property.
# Either the whole JSON key on one line:
GSC_SERVICE_ACCOUNT_JSON=
# ...or the two fields (keep \n escapes inside the key):
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# The property exactly as Search Console lists it, e.g. sc-domain:vanzoo.in or https://vanzoo.in/
GSC_SITE_URL=
# Optional: raises the free PageSpeed Insights quota used for Core Web Vitals.
PSI_API_KEY=
